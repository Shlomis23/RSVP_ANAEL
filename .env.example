# Use Neon checkout on a DEVELOPMENT branch, then neon env pull.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
APP_ORIGIN=http://127.0.0.1:3000
EVENT_SLUG=anael
# Set using npm run admin:password; never put the raw password in this file.
ADMIN_PASSWORD_HASH=
# HTTP local preview only; production requires HTTPS and __Host- cookies.
COOKIE_SECURE=false
